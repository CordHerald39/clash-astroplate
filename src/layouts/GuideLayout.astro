---
import '../styles/main.css';
import '../styles/guide.css';
import {name,href,full,indexable} from '../lib/site';
const {title,description,article=false,date,updated}=Astro.props;
const path=Astro.url.pathname;const canonical=new URL(path,Astro.site).href;
const json={'@context':'https://schema.org','@type':article?'Article':'WebPage',name:title,description,url:canonical,inLanguage:'zh-CN',...(article?{headline:title,datePublished:date,dateModified:updated,author:{'@type':'Organization',name:name+'编辑部'}}:{})};
const nav=[['/download/','下载'],['/mobile/','手机版'],['/windows/','电脑版'],['/docs/','教程'],['/blog/','博客']];
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | {name}</title><meta name="description" content={description}/><meta name="robots" content={indexable&&!path.endsWith('/404.html')?'index,follow':'noindex,follow'}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={canonical}/><meta property="og:image" content={full('/guide.svg')}/><link rel="icon" href={href('/favicon.svg')}/><link rel="alternate" type="application/rss+xml" title={name+' RSS'} href={href('/rss.xml')}/><script type="application/ld+json" set:html={JSON.stringify(json).replaceAll('<','\u003c')}/></head><body class="plate"><a class="skip" href="#main">跳至正文</a><header class="g-header"><div class="g-wrap g-nav"><a class="g-brand" href={href('/')}><span class="g-mark">C</span>{name}</a><nav aria-label="主导航">{nav.map(([u,t])=><a href={href(u)} aria-current={path===href(u)?'page':undefined}>{t}</a>)}</nav><a class="btn btn-primary g-cta" href={href('/download/')}>选择客户端 ↗</a></div></header><main id="main"><slot/></main><footer class="g-footer"><div class="g-wrap footer-top"><div><a class="g-brand" href={href('/')}>{name}</a><p>客户端来源、下载选择与配置方法。</p></div><div><a href={href('/official/')}>官网入口核对</a><a href={href('/about/')}>关于本站</a><a href={href('/privacy/')}>隐私说明</a><a href={href('/rss.xml')}>RSS</a></div></div><div class="g-wrap footer-bottom">© 2026 {name} · 独立中文指南</div></footer></body></html>
