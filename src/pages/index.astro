---
import Layout from '../layouts/GuideLayout.astro';
import {getCollection} from 'astro:content';import {href} from '../lib/site';
const posts=(await getCollection('blog',p=>!p.data.draft)).sort((a,b)=>b.data.updated.localeCompare(a.data.updated));
const group=(id)=>id==='official-sources'||id==='android-apk'?'下载与安装':id==='connection-check'?'连接故障':'订阅与配置';
---
<Layout title="Clash 中文下载站｜手机版与电脑版下载" description="搜索 Clash 下载、安卓安装、Windows 配置和连接故障教程，按问题查找开发者来源与具体操作步骤。">
<section class="help-hero"><div class="g-wrap help-hero-inner"><div><div class="help-breadcrumb">软件支持 / Clash 中文指南</div><h1>Clash 中文下载站<br/>手机版与电脑版下载</h1><p>从下载安装到订阅配置，找到当前这一步的答案。</p><label class="help-search" for="help-search"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6" fill="none" stroke="currentColor" stroke-width="2"/><path d="m15 15 6 6" stroke="currentColor" stroke-width="2"/></svg><input id="help-search" type="search" aria-label="搜索 Clash 教程" placeholder="搜索问题，例如：安卓安装、订阅、连不上" autocomplete="off"/><span>搜索教程</span></label><div class="popular-terms"><span>常见问题</span>{['安卓','订阅','模式'].map(t=><button type="button" data-query={t}>{t}</button>)}</div></div><aside class="start-box"><span class="start-symbol" aria-hidden="true">↗</span><h2>还没安装客户端？</h2><p>先选设备，再查看对应项目的原始下载入口。</p><a href={href('/windows/')}>Windows 电脑版 <span>→</span></a><a href={href('/mobile/')}>Android 手机版 <span>→</span></a><a href={href('/download/')}>全部客户端下载 <span>→</span></a></aside></div></section>
<section class="g-wrap help-workspace" id="answers"><aside class="topic-panel"><h2>按问题查找</h2><div class="topic-buttons">{['全部问题','下载与安装','订阅与配置','连接故障'].map((t,n)=><button type="button" data-topic={t} aria-pressed={n===0}>{t}<span>→</span></button>)}</div><div class="source-box"><h3>下载来源拿不准？</h3><p>核对客户端项目、维护者与发行记录。</p><a href={href('/official/')}>查看官网入口指南 ↗</a></div></aside><div class="answer-panel"><div class="answer-heading"><h2>常用解答</h2><p id="answer-count" aria-live="polite">{posts.length} 篇指南</p></div><div class="answer-list">{posts.map(p=><article class="answer-row" data-answer data-topic-name={group(p.id)} data-search={p.data.title+' '+p.data.description}><span class="answer-icon" aria-hidden="true">▤</span><div><span class="answer-topic">{group(p.id)}</span><h3><a href={href('/blog/'+p.id+'/')}>{p.data.title}</a></h3><p>{p.data.description}</p></div><a class="answer-arrow" href={href('/blog/'+p.id+'/')} aria-label={'阅读'+p.data.title}>↗</a></article>)}</div><div class="help-empty" id="help-empty" hidden><h3>没有找到匹配的教程</h3><p>可以换一个简短词语，或清空搜索查看全部指南。</p><button id="clear-search" type="button">清空搜索</button></div></div></section>
<section class="g-wrap help-bottom"><div><h2>第一次使用，按顺序看。</h2><p>确认客户端 → 导入配置 → 启动连接 → 检查实际访问。</p></div><a class="btn btn-primary" href={href('/docs/')}>打开完整入门教程 →</a></section>
<script>
const search=document.querySelector<HTMLInputElement>('#help-search');const rows=[...document.querySelectorAll<HTMLElement>('[data-answer]')];let topic='全部问题';
function filter(){const query=(search?.value||'').trim().toLowerCase();let count=0;rows.forEach(row=>{const visible=(topic==='全部问题'||row.dataset.topicName===topic)&&(!query||(row.dataset.search||'').toLowerCase().includes(query));row.hidden=!visible;if(visible)count++});document.querySelector('#answer-count')!.textContent=`${count} 篇指南`;document.querySelector<HTMLElement>('#help-empty')!.hidden=count>0;}
search?.addEventListener('input',filter);document.querySelectorAll<HTMLButtonElement>('[data-topic]').forEach(button=>button.addEventListener('click',()=>{topic=button.dataset.topic!;document.querySelectorAll('[data-topic]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));filter()}));document.querySelectorAll<HTMLButtonElement>('[data-query]').forEach(button=>button.addEventListener('click',()=>{search!.value=button.dataset.query!;filter();document.querySelector('#answers')?.scrollIntoView({behavior:'smooth'})}));document.querySelector('#clear-search')?.addEventListener('click',()=>{search!.value='';topic='全部问题';document.querySelectorAll<HTMLButtonElement>('[data-topic]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.topic===topic)));filter();search?.focus()});
</script>
<section class="g-wrap" style="padding:32px 24px"><h2>选择适合自己的机场订阅</h2><p>比较实际付款、流量周期与优惠条件，再按教程导入配置。</p><a href={href('/recommend/')}>查看机场推荐与套餐对比</a></section></Layout>