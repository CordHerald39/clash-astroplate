---
import {getCollection,render} from 'astro:content';import Layout from '../layouts/GuideLayout.astro';import {href,full} from '../lib/site';
export async function getStaticPaths(){return(await getCollection('pages',p=>!p.data.draft)).map(p=>({params:{slug:p.id},props:{p}}));}
const {p}=Astro.props;const {Content,headings}=await render(p);
---
<Layout title={p.data.title} description={p.data.description}><div class="g-wrap g-breadcrumb"><a href={href('/')}>首页</a><span>/</span><span>{p.data.title}</span></div><header class="g-wrap g-page-header"><span class="g-kicker">{p.data.category}</span><h1>{p.data.title}</h1><p>{p.data.description}</p></header><section class="g-wrap g-article-layout"><article class="g-prose"><Content/></article><aside class="g-toc"><h2>本页目录</h2>{headings.filter(x=>x.depth===2).map(h=><a href={'#'+h.slug}>{h.text}</a>)}<a href={href('/blog/')}>更多教程 →</a></aside></section><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'首页',item:full('/')},{'@type':'ListItem',position:2,name:p.data.title,item:full('/'+p.id+'/')}]})}/></Layout>
