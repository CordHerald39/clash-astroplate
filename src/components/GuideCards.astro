---
import {href} from '../lib/site';const {posts}=Astro.props;
---
<div class="g-cards">{posts.map((p,n)=><article class="g-card"><span class="g-kicker">{p.data.category}</span><h3><a href={href('/blog/'+p.id+'/')}>{p.data.title}</a></h3><p>{p.data.description}</p><div class="g-card-bottom"><time>{p.data.updated}</time><a href={href('/blog/'+p.id+'/')}>阅读全文 ↗</a></div></article>)}</div>
